<% var dash = theme.dashboard || {};
   var cols = worklog_board(dash.board_columns || 30);
   var projects = worklog_projects();
   var ov = worklog_overview(); %>
<section class="dash wrap">
  <div class="dash-head">
    <h1>模块看板</h1>
    <p class="dash-sub">按模块归拢每一条交付，共 <strong><%= cols.length %></strong> 个模块、<strong><%= ov.total.items %></strong> 条记录</p>
  </div>

  <div class="board-toolbar" data-board-toolbar>
    <div class="filter-group" role="group" aria-label="按项目筛选">
      <span class="filter-label">项目</span>
      <button class="chip is-on" type="button" data-filter-project="">全部</button>
      <% projects.forEach(function (p) { %>
        <button class="chip" type="button" data-filter-project="<%= p.name %>"><%= p.name %></button>
      <% }); %>
    </div>
    <div class="filter-group" role="group" aria-label="按上线状态筛选">
      <span class="filter-label">状态</span>
      <button class="chip is-on" type="button" data-filter-ship="">全部</button>
      <button class="chip" type="button" data-filter-ship="1">已上线</button>
      <button class="chip" type="button" data-filter-ship="0">未上线</button>
    </div>
    <label class="board-search">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" placeholder="搜索内容或模块" data-board-search aria-label="搜索看板内容">
    </label>
  </div>

  <div class="board" data-board>
    <% cols.forEach(function (col) { %>
      <div class="board-col" data-col data-modules="<%= col.module %>" data-projects="<%= col.projects.join(' ') %>">
        <div class="board-col-head">
          <span class="board-col-name" title="<%= col.module %>"><%= col.module %></span>
          <span class="board-col-count" data-col-count><%= col.count %></span>
        </div>
        <div class="board-col-body">
          <% col.cards.forEach(function (c) { %>
            <article class="board-card" data-card data-project="<%= c.project %>" data-ship="<%= c.shipped ? 1 : 0 %>" data-text="<%= (c.text + ' ' + col.module).toLowerCase() %>">
              <p class="board-card-text"><%= c.text %></p>
              <div class="board-card-meta">
                <time datetime="<%= c.date %>"><%= String(c.date).slice(5) %></time>
                <span class="card-proj"><%= c.project %></span>
                <% if (c.shipped) { %><span class="pill pill-ship">已发版</span><% } %>
                <% if (c.status) { %><span class="pill pill-status"><%= c.status %></span><% } %>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    <% }); %>
    <% if (!cols.length) { %>
      <p class="empty-block">还没有条目数据。运行 <code>python 99-脚本\publish_hexo.py</code> 生成 board.json 后即可看到看板。</p>
    <% } %>
  </div>
  <p class="board-empty" data-board-empty hidden>没有符合条件的条目</p>
</section>
