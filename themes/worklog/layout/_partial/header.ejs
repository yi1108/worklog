<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="<%- url_for('/') %>">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <strong><%= theme.site_name || config.title %></strong>
        <small><%= theme.site_desc || config.subtitle %></small>
      </span>
    </a>
    <nav class="nav">
      <% (theme.nav || []).forEach(function (item) { %>
        <a href="<%- url_for(item.url) %>"><%= item.text %></a>
      <% }); %>
    </nav>
    <button class="theme-toggle" type="button" aria-label="切换深浅色" title="切换深浅色">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</header>
