<% var projects = worklog_projects(); var ov = worklog_overview(); %>
<section class="dash wrap">
  <div class="dash-head">
    <h1>项目总览</h1>
    <p class="dash-sub">共 <strong><%= ov.projectCount %></strong> 个项目、<strong><%= ov.moduleCount %></strong> 个模块，累计 <strong><%= ov.total.days %></strong> 个记录日</p>
  </div>

  <div class="metrics">
    <div class="metric tone-a"><span class="metric-label">项目数</span><span class="metric-value"><%= ov.projectCount %><em>个</em></span></div>
    <div class="metric tone-b"><span class="metric-label">累计交付</span><span class="metric-value"><%= ov.total.items %><em>项</em></span></div>
    <div class="metric tone-c"><span class="metric-label">主线提交</span><span class="metric-value"><%= ov.total.commits %><em>次</em></span></div>
    <div class="metric tone-d"><span class="metric-label">生产发版</span><span class="metric-value"><%= ov.total.releases %><em>次</em></span></div>
    <div class="metric tone-e"><span class="metric-label">发版日占比</span><span class="metric-value"><%= ov.shipRate %><em>%</em></span></div>
  </div>

  <% var maxItems = 1; projects.forEach(function (p) { maxItems = Math.max(maxItems, p.items); }); %>
  <div class="proj-grid">
    <% projects.forEach(function (p) { %>
      <article class="proj-card">
        <div class="proj-card-head">
          <h2><%= p.name %></h2>
          <span class="proj-range"><%= p.first %> ~ <%= p.last %></span>
        </div>
        <div class="proj-stats">
          <span><b><%= p.days %></b>记录日</span>
          <span><b><%= p.weeks %></b>周</span>
          <span><b><%= p.items %></b>交付</span>
          <span><b><%= p.commits %></b>提交</span>
          <span><b><%= p.releases %></b>发版</span>
          <span><b><%= p.avgItems %></b>日均</span>
        </div>
        <div class="proj-share">
          <span class="proj-share-bar"><i style="width:<%= Math.round(p.items / maxItems * 100) %>%"></i></span>
          <span class="proj-share-label">交付占比</span>
        </div>
        <% if (p.modules.length) { %>
          <ul class="mod-list proj-mods">
            <% var top = p.modules[0].count || 1; %>
            <% p.modules.slice(0, 6).forEach(function (m) { %>
              <li>
                <span class="mod-name" title="<%= m.name %>"><%= m.name %></span>
                <span class="mod-bar"><i style="width:<%= Math.round(m.count / top * 100) %>%"></i></span>
                <span class="mod-count"><%= m.count %></span>
              </li>
            <% }); %>
          </ul>
        <% } %>
        <a class="proj-link" href="<%- url_for('/tags/' + p.name + '/') %>">查看 <%= p.name %> 记录 →</a>
      </article>
    <% }); %>
    <% if (!projects.length) { %><p class="empty-block">暂无项目数据</p><% } %>
  </div>
</section>
