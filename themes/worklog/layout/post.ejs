<article class="post wrap">
  <header class="post-head">
    <div class="post-kicker">
      <% if (page.kind === 'weekly') { %>
        <span class="tag-kind kind-weekly">周报</span>
      <% } else if (page.kind === 'worklog') { %>
        <span class="tag-kind kind-log">日志</span>
      <% } %>
      <% if (page.project_name) { %><span class="tag-proj"><%= page.project_name %></span><% } %>
      <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
    </div>
    <h1><%= page.title %></h1>
    <% if (page.stat_items || page.stat_commits || page.stat_releases) { %>
      <div class="post-stats">
        <% if (page.stat_days) { %><span><b><%= page.stat_days %></b>工作日</span><% } %>
        <% if (page.stat_items) { %><span><b><%= page.stat_items %></b>交付</span><% } %>
        <% if (page.stat_commits) { %><span><b><%= page.stat_commits %></b>提交</span><% } %>
        <% if (page.stat_releases) { %><span><b><%= page.stat_releases %></b>发版</span><% } %>
      </div>
    <% } %>
  </header>

  <div class="post-layout">
    <div class="post-body"><%- page.content %></div>
    <aside class="post-toc" id="toc">
      <% if (toc(page.content, { list_number: false })) { %>
        <p class="toc-title">目录</p>
        <%- toc(page.content, { list_number: false }) %>
      <% } %>
    </aside>
  </div>

  <% if (page.tags && page.tags.length) { %>
    <div class="post-tags">
      <% page.tags.each(function (t) { %>
        <a href="<%- url_for(t.path) %>">#<%= t.name %></a>
      <% }); %>
    </div>
  <% } %>

  <nav class="post-nav">
    <% if (page.prev) { %><a class="nav-prev" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %>
    <% if (page.next) { %><a class="nav-next" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
  </nav>
</article>
