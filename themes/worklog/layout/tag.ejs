<section class="wrap listing">
  <header class="listing-head">
    <h1>
      <% if (page.category) { %>分类：<%= page.category %>
      <% } else if (page.tag) { %>标签：<%= page.tag %>
      <% } else if (page.year) { %><%= page.year %><%= page.month ? ' 年 ' + page.month + ' 月' : ' 年' %>
      <% } else { %>全部记录<% } %>
    </h1>
    <p class="listing-count">共 <%= page.total ? site.posts.length : page.posts.length %> 篇</p>
  </header>

  <ul class="entry-list">
    <% page.posts.each(function (post) { %>
      <li class="entry">
        <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM-DD') %></time>
        <div class="entry-main">
          <a class="entry-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
          <div class="entry-meta">
            <% if (post.kind === 'weekly') { %><span class="tag-kind kind-weekly">周报</span><% } %>
            <% if (post.kind === 'worklog') { %><span class="tag-kind kind-log">日志</span><% } %>
            <% if (post.stat_items) { %><span><%= post.stat_items %> 交付</span><% } %>
            <% if (post.stat_releases) { %><span><%= post.stat_releases %> 发版</span><% } %>
          </div>
        </div>
      </li>
    <% }); %>
  </ul>

  <% if (page.total > 1) { %>
    <nav class="pager">
      <%- paginator({ prev_text: '← 上一页', next_text: '下一页 →' }) %>
    </nav>
  <% } %>
</section>
